## Example 4. Pull a subset of library entries and construct a distance matrix, then visualize with MDS and cluster with agglomerative hierarchical clustering
U = seq(1,10)
data = array(0,dim=c(length(U),1000))
maxmz = 0
for(i in 1:length(U)){
indices = which(Library$SpectralData$SpecID==U[i])
spec_mz = Library$SpectralData$mz[indices]
spec_int = Library$SpectralData$int[indices]
spec_int = spec_int/max(spec_int)
maxmz = max(maxmz,spec_mz)
data[i,] = spec2vec(spec_mz,spec_int,1000)
}
data = data[,1:maxmz]
D = dist(data,method="euclidean")
mds = cmdscale(D,k=2)
rownames(mds) = U
plot(mds,pch=19,cex=0)
text(mds[,1],mds[,2],U)
D = dist(data,method="cosine")
## Example 4. Pull a subset of library entries and construct a distance matrix, then visualize with MDS and cluster with agglomerative hierarchical clustering
U = seq(1,10)
D = array(1,dim=c(length(U),length(U)))
for(i in 1:length(U)){
indices_i = which(Library$SpectralData$SpecID==U[i])
spec_mz_i = Library$SpectralData$mz[indices]
spec_int = Library$SpectralData$int[indices]
spec_int_i = spec_int/max(spec_int)
for(j in 1:length(U)){
indices_j = which(Library$SpectralData$SpecID==U[j])
spec_mz_j = Library$SpectralData$mz[indices]
spec_int = Library$SpectralData$int[indices]
spec_int_j = spec_int/max(spec_int)
maxmz = max(spec_mz_i,spec_mz_j)
A = spec2vec(spec_mz_i,spec_int_i,maxmz)
B = spec2vec(spec_mz_j,spec_int_j,maxmz)
D[i,j] = cosineSim(A,B)
}
}
D = 1-D
mds = cmdscale(D,k=2)
## Example 4. Pull a subset of library entries and construct a distance matrix, then visualize with MDS and cluster with agglomerative hierarchical clustering
