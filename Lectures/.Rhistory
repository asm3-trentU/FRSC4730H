StrucSimScores = numeric(nComputes)
counter = 0
stime <- system.time({
for(i in 1:nCompounds){
SMILES_i = strsplit(Library$IndexData$SMILES[COI[i]],"\t")[[1]][1]
mol_i = parse.smiles(SMILES_i)[[1]]
fp_i = get.fingerprint(mol_i,type="standard")@bits # pulling the bits directly
indices_i = which(Library$SpectralData$SpecID==COI[i])
spec_mz_i = Library$SpectralData$mz[indices_i]
spec_int = Library$SpectralData$int[indices_i]
spec_int_i = spec_int/max(spec_int)
for(j in 1:nCompounds){
if(i >= j) next
SMILES_j = strsplit(Library$IndexData$SMILES[COI[j]],"\t")[[1]][1]
mol_j = parse.smiles(SMILES_j)[[1]]
fp_j = get.fingerprint(mol_j,type="standard")@bits
indices_j = which(Library$SpectralData$SpecID==COI[j])
spec_mz_j = Library$SpectralData$mz[indices_j]
spec_int = Library$SpectralData$int[indices_j]
spec_int_j = spec_int/max(spec_int)
maxmz = max(spec_mz_i,spec_mz_j)
A = spec2vec(spec_mz_i,spec_int_i,maxmz)
B = spec2vec(spec_mz_j,spec_int_j,maxmz)
counter = counter + 1
SpecSimScores[counter] = cosineSim(A,B)
StrucSimScores[counter] = length(intersect(fp_i,fp_j))/length(union(fp_i,fp_j)) # this is a Tanimoto similarity coefficient
}
}
})[3]
cat(paste0("This computation took ",round(stime,3)," seconds.\n"))
plot(SpecSimScores,StrucSimScores)
